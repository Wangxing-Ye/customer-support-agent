OPENAI_API_KEY=sk-proj-xxxxxxxx
OPENAI_MODEL=gpt-5.6-luna
# Chat LLM: openai | anthropic | auto
# auto → anthropic only if OPENAI_MODEL starts with claude, or OPENAI_API_KEY is unset and ANTHROPIC_API_KEY is set
# For Claude chat, set LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY (use official Anthropic model ids)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
JWT_SECRET=change-me-to-a-long-random-string
# Anonymous widget session JWT (minutes). Frontend refreshes before expiry.
SESSION_JWT_EXPIRE_MINUTES=30
JWT_AUDIENCE=customer-support-widget
# Renew when fewer than this many seconds remain (frontend).
JWT_REFRESH_SKEW_SECONDS=300
# Owner dashboard (separate from widget JWT). First login forces email bind + password change.
OWNER_USERNAME=admin
OWNER_DEFAULT_PASSWORD=changeme
OWNER_JWT_AUDIENCE=owner-dashboard
OWNER_JWT_EXPIRE_MINUTES=480
ADMIN_UI_ORIGIN=http://localhost:3000
# Phase-1 in-process rate limits (per API process; use Redis later for multi-worker).
# Max POST /auth/token per client IP per rolling hour.
SESSION_PER_IP_PER_HOUR=60
SESSION_REFRESH_PER_SID_PER_MINUTE=10
# Max user chat turns (POST /chat and /chat/stream) per sid lifetime.
# Refresh keeps the same sid and does not reset this counter. 0 disables.
SESSION_CHAT_TURNS_PER_SID=100
# true only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3003,http://localhost:3003,http://127.0.0.1:4173,http://localhost:4173

# Firm branding (single-tenant demo)
FIRM_NAME=Palo Alto Advisory CPA
AGENT_NAME=Emma
FIRM_TIMEZONE=America/Los_Angeles
FIRM_WEBSITE=http://paloaltoadvisorycpa.com/
FIRM_LOCATION=1451 Middlefield Rd, Palo Alto, CA 94301
PUBLIC_BASE_URL=http://127.0.0.1:8000
PAYMENT_HOLD_MINUTES=15
RAG_BRAND_PREFIX=Palo Alto Advisory CPA
RAG_BRAND_RETRY_SKIP_SUBSTRINGS=

# PostgreSQL (preferred)
# docker compose up -d
